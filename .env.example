# ==============================================================================
# FLANKI ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your Supabase project credentials.
# Never commit real credentials or service keys into git!
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe to embed in client apps, protected by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
